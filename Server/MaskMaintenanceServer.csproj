<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>MaskMaintenance</RootNamespace>
    <AssemblyName>MaskMaintenanceServer</AssemblyName>
    <Version>$(ModVersion)</Version>
    <Authors>$(ModAuthor)</Authors>
    <Product>$(ModName)</Product>
    <Description>Gives the Clin window cleaner three charges for treating face shields.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
  </ItemGroup>

  <!-- build order only: the package target below picks the client dll up from disk -->
  <ItemGroup>
    <ProjectReference Include="..\Manimal.MaskMaintenance.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <PropertyGroup>
    <ServerModFolder>MaskMaintenanceServer</ServerModFolder>
    <RepoRoot>$(MSBuildProjectDirectory)\..\</RepoRoot>
    <ClientBinDir>$(RepoRoot)bin\$(Configuration)\netstandard2.1</ClientBinDir>
  </PropertyGroup>

  <!-- opt-in: dotnet build Manimal.MaskMaintenance.sln -c Release -p:DeployToGame=true -->
  <Target Name="DeployServerToSPTDev" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(SptPath)\SPT_Runtime\user\mods\$(ServerModFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptPath)\SPT_Runtime\user\mods\$(ServerModFolder)" />
  </Target>

  <!-- one install-ready zip holding both halves -->
  <Target Name="PackageModForDistribution" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ZipFileName>$(ModName)-$(ModVersion).zip</ZipFileName>
      <TempPackageDir>$(MSBuildProjectDirectory)\obj\Package</TempPackageDir>
      <ServerOutDir>$(TempPackageDir)\SPT_Runtime\user\mods\$(ServerModFolder)</ServerOutDir>
      <ClientOutDir>$(TempPackageDir)\BepInEx\plugins\$(ModName)</ClientOutDir>
      <ClientDll>$(ClientBinDir)\$(ModAssemblyName).dll</ClientDll>
    </PropertyGroup>
    <Error Text="Client dll not found at $(ClientDll). Build the solution, not just the server project." Condition="!Exists('$(ClientDll)')" />
    <RemoveDir Directories="$(TempPackageDir)" />
    <MakeDir Directories="$(ServerOutDir);$(ClientOutDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ServerOutDir)" />
    <Copy SourceFiles="$(ClientDll);$(RepoRoot)bundles\visor_wipe.bundle;$(RepoRoot)bundles\visor_wipe.path.txt" DestinationFolder="$(ClientOutDir)" />
    <Copy SourceFiles="$(RepoRoot)LICENSE" DestinationFolder="$(TempPackageDir)" Condition="Exists('$(RepoRoot)LICENSE')" />
    <ZipDirectory SourceDirectory="$(TempPackageDir)" DestinationFile="$(RepoRoot)$(ZipFileName)" Overwrite="true" />
    <RemoveDir Directories="$(TempPackageDir)" />
    <Message Text="Packaged: $(RepoRoot)$(ZipFileName)" Importance="high" />
  </Target>
</Project>
